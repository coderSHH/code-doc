{
  "name": "dev-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs && node scripts/tag-pagefind.mjs && pagefind --site docs/.vitepress/dist",
    "preview": "vitepress preview docs",
    "build:search": "pagefind --site docs/.vitepress/dist",
    "ingest": "node scripts/ingest-notes.mjs",
    "ingest:force": "node scripts/ingest-notes.mjs --force"
  },
  "devDependencies": {
    "vitepress": "^1.6.3",
    "vue": "^3.5.13",
    "pagefind": "^1.3.0"
  }
}
